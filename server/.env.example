# 复制到 /etc/gok-share.env（chmod 600），或者用 --env-from-file 喂给 pm2。
#
# 两把密钥都用下面这条生成，各生成一次，别把同一个值填两处（程序会拒绝启动）：
#   openssl rand -hex 32
#
# 存好后请把这份文件和数据库备份分开存放：盐和 db 一起泄露，
# 加盐哈希就白做了（QQ 空间在 GPU 上是分钟级的事）。

GOK_SALT=
GOK_ADMIN_SECRET=

# 监听地址。默认 127.0.0.1，走反代。设成 0.0.0.0 就是直连公网跑明文 HTTP，
# 那时候 token 在链路上是裸的，请先确认你真的要这样。
#GOK_HOST=127.0.0.1

#GOK_PORT=8787

# SQLite 文件位置，默认 ./data/share.db（相对本目录）
#GOK_DB=

# 是否信任 X-Forwarded-For。
# 不设的话：监听回环 = 信任（反代场景），监听 0.0.0.0 = 不信任（防伪造）。
# 只有在自动判断不符合你的部署时才需要显式指定。
#GOK_TRUST_PROXY=1

# 同一 client 重复查同一个 QQ 时的响应冷却，毫秒。0 = 关闭
#GOK_READ_COOLDOWN_MS=60000
